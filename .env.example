APP_ENVIRONMENT=dev

SENTRY_DNS=

AGENT_DEFAULT_PERSONA_NAME=Customized SQL Assistant
AGENT_DEFAULT_RESPONSE_STYLE=technical
AGENT_DEFAULT_LANGUAGE=pt-BR

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
STORAGE_TYPE=minio
SECURITY_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sql-agents-raw
MINIO_SECURE=false

MAX_UPLOAD_SIZE_BYTES=104857600
UPLOAD_CHUNK_SIZE_BYTES=5242880
SIGNED_URL_EXPIRES_SECONDS=3600

DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5433/sql_agents
POSTGRES_PORT=5433

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna